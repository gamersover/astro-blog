---
import '../styles/global.css';
import {ClientRouter} from 'astro:transitions';
import {site} from '../lib/posts.mjs';
interface Props {title?:string; description?:string; article?:boolean; noindex?:boolean;}
const {title,description=site.description,article=false,noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const current=Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN" transition:animate="none">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <ClientRouter fallback="swap"/>
 <title>{title?`${title} · ${site.title}`:site.title+' · 数学、代码与生活'}</title>
 <meta name="description" content={description}/><link rel="canonical" href={canonical}/>
 <meta property="og:title" content={title||site.title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/>
 {(noindex||import.meta.env.SITE_LIVE!=='true')&&<meta name="robots" content="noindex,follow"/>}
 <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
 <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
 <link rel="manifest" href="/site.webmanifest"/>
 <meta name="apple-mobile-web-app-title" content={site.title}/>
 <meta name="theme-color" content="#f6f4ed"/>
 <link rel="alternate" type="application/rss+xml" title="尘雨尘风 RSS" href="/rss.xml"/>
 <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('blog-theme')||'light'}catch{}</script>
</head>
<body>
 <a class="skip-link" href="#main">跳到正文</a>
 <header class="site-header wrap">
  <a class="wordmark" href="/" aria-label="尘雨尘风 首页"><span class="seal" aria-hidden="true">尘</span><span>尘雨尘风<small>CHEN'S JOURNAL</small></span></a>
  <nav aria-label="主导航">
   <a href="/" data-astro-prefetch="load" aria-current={current==='/'?'page':undefined}>首页</a>
   <a href="/topics/" data-astro-prefetch="load" aria-current={current.startsWith('/topics')?'page':undefined}>专题</a>
   <a href="/archives/" data-astro-prefetch="load" aria-current={current.startsWith('/archives')?'page':undefined}>归档</a>
   <a href="/about/" data-astro-prefetch="load" aria-current={current==='/about/'?'page':undefined}>关于</a>
   <a href="/search/" data-astro-prefetch="load" class="search-link" aria-label="搜索文章"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg><span>搜索</span></a>
   <button id="theme-switch" class="theme-switch" aria-label="切换深浅主题" title="切换深浅主题">◐</button>
  </nav>
 </header>
 <main id="main"><slot/></main>
 <footer class="site-footer wrap"><div><a class="footer-title" href="/">尘雨尘风</a><p>写下所见，留下所思。</p></div><div class="footer-links"><a href="https://www.caoqinping.com/">个人主页 ↗</a><a href="/tags/">标签</a><a href="/categories/">分类</a><a href="/rss.xml">RSS ↗</a><span>© {new Date().getFullYear()} 陈华杰</span></div></footer>
 <script>
  import type {TransitionBeforeSwapEvent} from 'astro:transitions/client';
  document.addEventListener('astro:before-swap',(event)=>{
   (event as TransitionBeforeSwapEvent).newDocument.documentElement.dataset.theme=document.documentElement.dataset.theme||'light';
  });
  document.addEventListener('click',(event)=>{
   if(!(event.target instanceof Element)||!event.target.closest('#theme-switch'))return;
   const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';
   document.documentElement.dataset.theme=theme;try{localStorage.setItem('blog-theme',theme)}catch{}
  });
 </script>
</body>
</html>
