---
interface Props { topic: string; }
const {topic}=Astro.props;
---
<svg class="topic-diagram" viewBox="0 0 180 120" fill="none" aria-hidden="true">
 {topic==='mind'&&<>
  <path class="diagram-guide" d="M18 60h144M90 12v96"/>
  <circle class="mind-circle mind-left" cx="72" cy="60" r="37"/><circle class="mind-circle mind-right" cx="108" cy="60" r="37"/>
  <path class="diagram-emphasis" d="M90 28a37 37 0 0 1 0 64 37 37 0 0 1 0-64Z"/>
  <circle class="diagram-point" cx="90" cy="60" r="3"/>
 </>}
 {topic==='math'&&<>
  <path class="diagram-guide" d="M28 15v86h132M28 58h130M91 17v84"/>
  <path d="M32 87C54 85 64 35 89 35s35 39 66 5"/>
  <path class="diagram-tangent" d="M49 68.67 96 16.38"/>
  <g class="math-cursor"><circle class="diagram-point cursor-halo" r="8"/><circle class="diagram-point" r="3"/></g>
  <path d="m24 21 4-6 4 6m122 76 6 4-6 4"/>
 </>}
 {topic==='engineering'&&<>
  <path class="diagram-guide" d="M17 60h146"/>
  <path d="M43 60h25V29h42m-42 31v31h42m24-62h13v62h-13m13-31h16"/>
  <rect class="code-node node-input" x="19" y="48" width="24" height="24" rx="3"/>
  <rect class="code-node node-upper" x="110" y="17" width="24" height="24" rx="3"/>
  <rect class="code-node node-lower" x="110" y="79" width="24" height="24" rx="3"/>
  <circle class="diagram-point" cx="68" cy="60" r="3"/>
  <path d="m157 56 6 4-6 4"/>
 </>}
 {topic==='poetry'&&<>
  <path class="diagram-guide" d="M20 95h140"/>
  <path class="poetry-wave wave-near" d="M24 72c20-22 30 22 50 0s30 22 50 0 24 2 32 0"/><path class="poetry-wave wave-far" d="M24 84c20-22 30 22 50 0s30 22 50 0 24 2 32 0"/>
  <circle cx="112" cy="35" r="16"/>
  <path class="diagram-guide" d="M112 11v48M88 35h48"/>
  <circle class="diagram-point" cx="48" cy="38" r="2.5"/>
 </>}
</svg>
