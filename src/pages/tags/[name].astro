---
import Base from '../../layouts/Base.astro';import PostList from '../../components/PostList.astro';import {getPosts} from '../../lib/posts.mjs';
export function getStaticPaths(){return [...new Set(getPosts().flatMap(p=>p.tags))].map(name=>({params:{name},props:{name}}))}
const {name}=Astro.props;const posts=getPosts().filter(p=>p.tags.includes(name));
---
<Base title={name}><section class="wrap page-heading"><p class="eyebrow">标签 / {posts.length} 篇文章</p><h1>{name}</h1><a class="text-link" href="/tags/">全部标签 ↗</a></section><section class="wrap page-section"><PostList posts={posts}/></section></Base>
