---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TopicCards from '../components/TopicCards.astro';
import {getPosts,displayDate} from '../lib/posts.mjs';
const posts=getPosts();
const featured=posts.find(p=>p.slug==='心之学：关于所向、所归与共鸣')!;
---
<Base>
 <section class="hero wrap"><div><p class="eyebrow"><span class="tiny-dot"></span> 陈华杰的文字与思考 · 始于 2019</p><h1>数学、代码，<br/>与<span class="soft-ink">心之所向。</span></h1><p class="hero-intro">在定义与证明中寻找秩序，在代码与实践中理解世界。<br class="desktop"/>也在诗与生活里，留一些不必有用的时刻。</p></div><div class="hero-margin" aria-hidden="true"><span class="vertical-note">有所为，亦有所归。</span><svg class="orbit" viewBox="0 0 250 250" fill="none"><circle cx="125" cy="125" r="91"/><ellipse cx="125" cy="125" rx="110" ry="40" transform="rotate(-35 125 125)"/><path d="M25 185 225 65M125 18v214"/><circle class="orbit-dot" cx="198" cy="69" r="5"/></svg><span class="margin-label">NOTES ON THINKING & LIVING</span></div></section>
 <section class="wrap featured-section" aria-labelledby="featured-title"><div class="section-heading"><h2 id="featured-title"><span>01</span> 从这里读起</h2><span class="eyebrow">EDITOR'S PICK</span></div><div class="feature-grid"><a class="feature-main" href={featured.url}><div class="feature-top"><span class="eyebrow">心之学 · 系列开篇</span><span class="feature-number">一</span></div><h2>心之所向，<br/>亦是心之所归。</h2><p>现实中的作为，与内心认同的生活，<br/>如何在漫长的行走中渐渐重合？</p><span class="feature-bottom">{displayDate(featured.date)} <span>阅读文章 <b>↗</b></span></span></a><div class="feature-aside"><p class="eyebrow">持续书写 / ONGOING SERIES</p><a href="/topics/math/"><span class="aside-number">∑</span><div><h3>数学之美</h3><p>从极限出发，走进微积分的世界。</p><span>沿着问题，一步一步 →</span></div></a><a href="/topics/engineering/"><span class="aside-number">{`{ }`}</span><div><h3>代码与实践</h3><p>算法、Agent，和亲手做过的事。</p><span>让经验成为下一步的起点 →</span></div></a><p class="aside-foot">{posts.length} 篇记录 · 每一次理解，都值得写下</p></div></div></section>
 <section class="wrap latest-section" aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title"><span>02</span> 最近写下</h2><a class="text-link" href="/archives/">全部文章 ↗</a></div><PostList posts={posts.slice(0,6)}/></section>
 <section class="wrap topics-section" aria-labelledby="topics-title"><div class="section-heading"><h2 id="topics-title"><span>03</span> 沿着一个主题</h2><a class="text-link" href="/topics/">浏览专题 ↗</a></div><TopicCards/></section>
 <section class="closing wrap"><span class="seal" aria-hidden="true">记</span><p>以文字为线索，<br/>慢慢认识世界，也慢慢认识自己。</p><a class="text-link" href="/about/">关于这个博客 ↗</a></section>
</Base>
