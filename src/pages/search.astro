---
import Base from '../layouts/Base.astro';
---
<Base title="搜索" noindex><section class="wrap page-heading"><p class="eyebrow">FIND A THOUGHT</p><h1>找一篇，想读的文章。</h1><p>搜索标题、标签或正文中的词语。</p></section><section class="wrap page-section"><form class="search-form" role="search"><label class="sr-only" for="query">搜索文章</label><input id="query" type="search" name="q" placeholder="试试「极限」「Agent」「心之学」" autocomplete="off"/><button type="submit">搜索</button></form><p class="search-status" role="status" aria-live="polite">输入关键词，开始寻找。</p><div id="results"></div><noscript>搜索需要 JavaScript，也可以前往 <a href="/archives/">文章归档</a> 浏览全部文章。</noscript></section>
<script>
type Entry={title:string;url:string;date:string;excerpt:string;tags:string[];text:string};
let index:Promise<Entry[]>|undefined;
function loadIndex(){
 return index??=(fetch('/search-index.json').then(response=>{
  if(!response.ok)throw Error('Search index unavailable');
  return response.json() as Promise<Entry[]>;
 }).catch(error=>{index=undefined;throw error}));
}
let cleanup=()=>{};
document.addEventListener('astro:before-swap',()=>cleanup());
document.addEventListener('astro:page-load',()=>{
 cleanup();
 const input=document.querySelector<HTMLInputElement>('#query');
 const results=document.querySelector('#results');
 const status=document.querySelector('.search-status');
 const form=document.querySelector<HTMLFormElement>('.search-form');
 if(!input||!results||!status||!form)return;
 const controller=new AbortController();
 const {signal}=controller;
 let version=0;
 let timer:ReturnType<typeof setTimeout>;
 cleanup=()=>{controller.abort();clearTimeout(timer);version++};
 async function search(){
  if(!input||!results||!status||signal.aborted)return;
  const id=++version;
  const query=input.value.trim();results.replaceChildren();
  const url=new URL(location.href);
  query?url.searchParams.set('q',query):url.searchParams.delete('q');
  // Preserve the router's history index and scroll restoration state.
  history.replaceState(history.state,'',url);
  if(!query){status.textContent='输入关键词，开始寻找。';return}
  status.textContent='正在查找…';
  try{
   const entries=await loadIndex();
   if(signal.aborted||id!==version)return;
   const terms=query.toLocaleLowerCase().split(/\s+/);
   const found=entries.filter(p=>terms.every(t=>(p.title+' '+p.tags.join(' ')+' '+p.text).toLocaleLowerCase().includes(t))).sort((a,b)=>Number(b.title.toLocaleLowerCase().includes(query.toLocaleLowerCase()))-Number(a.title.toLocaleLowerCase().includes(query.toLocaleLowerCase())));
   status.textContent=found.length?`找到 ${found.length} 篇文章`:'暂时没有找到，试试更短的关键词。';
   for(const p of found){
    const article=document.createElement('article');article.className='search-result';
    const date=document.createElement('time');date.textContent=p.date;
    const title=document.createElement('h2');const a=document.createElement('a');a.href=p.url;a.textContent=p.title;title.append(a);
    const excerpt=document.createElement('p');excerpt.textContent=p.excerpt;
    article.append(date,title,excerpt);results.append(article);
   }
  }catch{if(!signal.aborted&&id===version)status.textContent='搜索暂时无法加载，请重试，或前往归档浏览。'}
 }
 form.addEventListener('submit',e=>{e.preventDefault();clearTimeout(timer);search()},{signal});
 input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(search,200)},{signal});
 input.value=new URLSearchParams(location.search).get('q')||'';
 if(input.value)search();
});
</script><style>.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}</style></Base>
